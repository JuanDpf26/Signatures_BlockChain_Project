# Copia este archivo como .env y llena los valores (el .env no se sube a GitHub)
PORT=3000
NODE_ENV=development
DATABASE_URL=
JWT_SECRET=
SUPABASE_URL=
SUPABASE_KEY=
RECAPTCHA_SECRET=
GOOGLE_CLIENT_ID=
GROQ_API_KEY=

# Correo (Gmail con contraseña de aplicación de 16 letras)
EMAIL_USER=
EMAIL_PASS=

# URLs
APP_BASE_URL=http://localhost:8080
APP_BASE_URL_BACKEND=http://localhost:3000

# Blockchain (Sepolia)
BLOCKCHAIN_RPC_URL=
BLOCKCHAIN_PRIVATE_KEY=
BLOCKCHAIN_CONTRACT_ADDRESS=

# Firebase: JSON completo de la cuenta de servicio en una sola línea (opcional en local)
FIREBASE_SERVICE_ACCOUNT=
